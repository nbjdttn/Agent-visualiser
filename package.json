{
  "name": "agent-visualiser",
  "version": "0.1.0",
  "private": true,
  "description": "One dashboard for your AI usage: Claude Code, Codex CLI, the Anthropic API and the OpenAI API, broken down by project, model, day and month.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "dev:demo": "concurrently -k -n api,web -c cyan,magenta \"tsx watch --clear-screen=false server/index.ts --demo\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "demo": "tsx server/index.ts --demo",
    "sync": "tsx scripts/sync.ts",
    "gentle": "tsx scripts/gentle.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "update-pricing": "tsx scripts/update-pricing.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "hono": "^4.13.14",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
