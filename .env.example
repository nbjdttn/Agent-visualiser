# Copy this file to .env and fill in what you need. Every setting is optional:
# with nothing set, the app reads your local Claude Code and Codex CLI logs.

# --- Server -----------------------------------------------------------------
# Port for the API (and the built app when you run `npm start`).
PORT=4777
# Keep 127.0.0.1 so only your own machine can open the dashboard.
# Your session titles and folder names are personal; don't expose them on a network.
HOST=127.0.0.1

# --- Local agent logs (auto-detected) ---------------------------------------
# Claude Code: defaults to ~/.config/claude and ~/.claude. Comma-separate several.
# CLAUDE_CONFIG_DIR=/Users/me/.claude
# Codex CLI: defaults to ~/.codex
# CODEX_HOME=/Users/me/.codex

# --- Organisation usage APIs (optional) -------------------------------------
# Anthropic Admin API key (sk-ant-admin01-...). Console organisations only.
# Adds API usage by model and workspace.
# ANTHROPIC_ADMIN_KEY=
# OpenAI Admin key (sk-admin-...). Adds API usage by model and project.
# OPENAI_ADMIN_KEY=
# How many days of organisation usage to fetch (default 90).
# API_LOOKBACK_DAYS=90

# --- Pricing ----------------------------------------------------------------
# Costs are estimates from public per-token prices. The app refreshes prices from
# LiteLLM's public price list once a day. Set to 1 to use only the bundled prices.
# PRICING_OFFLINE=0

# --- Demo -------------------------------------------------------------------
# Set to 1 to always show generated demo data (or run `npm run demo`).
# DEMO=0
